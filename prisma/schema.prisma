datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

enum BookingType {
  SPACE_ONLY
  SERVICES_ONLY
  SPACE_AND_SERVICES
}

/// Which workspace a booking belongs to. SPACE = venue-rental only, no Event exists yet.
/// EVENT = the booking runs a full occasion. Distinct from `BookingType`, which is advisory
/// line-composition metadata; `context` is the structural switch the Space/Event workspace split
/// is built on.
enum BookingContext {
  SPACE
  EVENT
}

enum BookingStatus {
  RESERVED
  CONFIRMED
  COMPLETED
  CANCELLED
  DRAFT
  PENDING_CONFIRMATION
  WAITING_LIST
}

enum EventStatus {
  PLANNING
  READY
  IN_PROGRESS
  COMPLETED
}

enum ExecutionType {
  INTERNAL
  EXTERNAL
}

/// Internal execution ladder for a work order — how far along the venue's own team is.
enum WorkOrderStatus {
  PLANNING
  READY
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// External supplier fulfillment ladder — independent of WorkOrderStatus and of payment.
/// Only meaningful when providerType = EXTERNAL; null for INTERNAL services.
enum SupplierStatus {
  REQUESTED
  CONFIRMED
  DELIVERED
  COMPLETED
  CANCELLED
}

/// Whether the supplier has been paid for this work order — independent of delivery status
/// (a supplier can have delivered and not been paid, or been paid in advance of delivery).
enum ServicePaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  M_PESA
  E_MOLA
  BCI
  BIM
  CONTA_MOVEL
  OTHER
}

enum ExpenseStatus {
  PENDING
  PAID
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

/// Where a `BookingService` line came from — added straight from the catalog, or exploded out of
/// an applied `Package`. Purely provenance; doesn't change how the line behaves afterward.
enum ServiceSource {
  DIRECT
  PACKAGE
}

/// How a `ServiceInventoryRequirement`'s `quantity` scales when resolved onto an actual booking.
enum QuantityType {
  FIXED
  PER_GUEST
  PER_UNIT
}

/// Lifecycle of a `BookingServiceResource`'s commitment — PLANNED means nothing is reserved yet
/// (just a known need); RESERVED/IN_USE count as active commitments against availability; RETURNED
/// and RELEASED both free the stock back up (RETURNED after physical use, RELEASED as a plain exit
/// before or after reserving, folding what used to be a separate "cancelled" outcome into the same
/// terminal state).
enum ResourceAllocationStatus {
  PLANNED
  RESERVED
  IN_USE
  RETURNED
  RELEASED
}

/// The inventory movement ledger's event types — "what physically happened," independent of a
/// reservation's commitment status. Never rewritten to hide history; corrections are new rows.
enum InventoryTransactionType {
  PURCHASE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RESERVE
  RELEASE
  ALLOCATE
  USE
  RETURN
  DAMAGE
  LOSS
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  space               Space?
  clients             Client[]
  bookings            Booking[]
  services            Service[]
  packages            Package[]
  suppliers           Supplier[]
  inventoryItems      InventoryItem[]
  inventoryCategories InventoryCategory[]
  staff               Staff[]
  scheduledPayments   ScheduledPayment[]
  paymentTransactions PaymentTransaction[]
  expenses            Expense[]
  auditLogs           AuditLog[]

  @@map("tenants")
}

model Space {
  id          String   @id @default(cuid())
  tenantId    String   @unique
  name        String
  capacity    Int
  address     String?
  description String?
  photos      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("spaces")
}

model Client {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  phone       String?
  email       String?
  companyName String?
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([tenantId])
  @@index([active])
  @@map("clients")
}

model Booking {
  id                     String         @id @default(cuid())
  tenantId               String
  clientId               String
  spaceId                String
  bookingType            BookingType    @default(SPACE_AND_SERVICES)
  /// Structural workspace switch — see `BookingContext` doc comment. Defaults to EVENT because,
  /// historically, every booking got an Event unconditionally; SPACE bookings are a new concept.
  context                BookingContext @default(EVENT)
  eventDate              DateTime
  /// Real reservation window for the space, used for overlap-conflict checking.
  /// `eventDate` stays in sync (same calendar day as `startAt`) for existing day-level UI/queries.
  startAt                DateTime
  endAt                  DateTime
  guestCount             Int            @default(0)
  status                 BookingStatus  @default(RESERVED)
  notes                  String?
  depositDueDate         DateTime?
  discount               Decimal?       @default(0) @db.Decimal(12, 2)
  /// Required to confirm a booking whose guestCount exceeds the space's capacity — otherwise
  /// confirmation is blocked. Null when capacity was never exceeded or never overridden.
  capacityOverrideReason String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  tenant              Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client              Client                   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  space               Space                    @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  event               Event?
  bookingServices     BookingService[]
  bookingPackages     BookingPackage[]
  resources           BookingServiceResource[]
  paymentPlans        PaymentPlan[]
  scheduledPayments   ScheduledPayment[]
  paymentTransactions PaymentTransaction[]

  @@index([tenantId])
  @@index([clientId])
  @@index([spaceId])
  @@index([status])
  @@index([context])
  @@index([eventDate])
  @@index([startAt, endAt])
  @@index([context, startAt])
  @@map("bookings")
}

model Event {
  id         String      @id @default(cuid())
  bookingId  String      @unique
  name       String
  date       DateTime
  guestCount Int         @default(0)
  status     EventStatus @default(PLANNING)
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  booking               Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingServices       BookingService[]
  guests                Guest[]
  expenses              Expense[]
  inventoryTransactions InventoryTransaction[]
  statusOverrides       EventStatusOverride[]

  @@index([bookingId])
  @@index([status])
  @@index([date])
  @@map("events")
}

/// Audit trail for manual Event.status overrides (Phase 10). Status is normally derived from
/// BookingService progress — every entry here represents a deliberate manual correction, not the
/// default path, and the next automatic recalculation (any service status change) can supersede it.
model EventStatusOverride {
  id             String      @id @default(cuid())
  eventId        String
  previousStatus EventStatus
  newStatus      EventStatus
  reason         String
  overriddenBy   String
  createdAt      DateTime    @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_status_overrides")
}

/// General-purpose audit trail — currently used for Booking context cross-over (promote/demote), the
/// first place a "who did what, when, and why" record was needed outside the narrower
/// `EventStatusOverride`. `entity`/`entityId` are a loose polymorphic reference (e.g.
/// `entity: "Booking"`) rather than a typed relation, so this can log against any model without a
/// schema change every time a new auditable action is added.
model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  entity    String
  entityId  String
  action    String
  detail    String?
  actor     String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model Service {
  id                  String         @id @default(cuid())
  tenantId            String
  name                String
  category            String
  /// Which workspace(s) this service can be selected from — see `ServiceContext` doc comment.
  /// Defaults to `BOTH` on every pre-existing row, which preserves the exact "visible everywhere"
  /// behavior every service had before contexting existed; re-contexting real catalog rows to
  /// SPACE-only or EVENT-only is a deliberate follow-up the catalog owner does via the Services
  /// page, not something inferred automatically from name/category.
  context             ServiceContext @default(BOTH)
  /// The provider type this service defaults to when added to a booking. Purely a suggested
  /// starting point — `BookingService.providerType` is the real per-booking decision and can differ.
  defaultProviderType ExecutionType  @default(INTERNAL)
  priceType           PriceType      @default(FIXED)
  defaultPrice        Decimal        @default(0) @db.Decimal(12, 2)
  active              Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  tenant                Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookingServices       BookingService[]
  packageItems          PackageItem[]
  bookingPackageItems   BookingPackageItem[]
  inventoryRequirements ServiceInventoryRequirement[]

  @@index([tenantId])
  @@index([category])
  @@index([active])
  @@index([context])
  @@map("services")
}

/// Which workspace a bundle is offered in — Space packages are room-only bundles (e.g. the venue
/// + furniture), Event packages bundle a full occasion's services (catering, decor, etc.). Unlike
/// `ServiceContext`, a package never gets `BOTH` — the user's own model is that a cross-workspace need
/// (e.g. an Event booking that also needs the venue) is met by applying two separate packages, not
/// one mixed one; keeping packages single-workspace prevents accidental catalog mixing.
enum PackageContext {
  SPACE
  EVENT
}

/// Whether a `Package`'s total is always derived live from its `items` (`COMPUTED`, the default) or
/// pinned to an explicit negotiated flat rate via `Package.price` (`FIXED`).
enum PackagePricingMode {
  COMPUTED
  FIXED
}

/// Which workspace(s) a catalog `Service` can be selected from. `BOTH` is for genuinely
/// cross-workspace services (e.g. house cleaning, general staff) — everything else should be scoped
/// to exactly where it's actually offered. A SPACE booking's catalog only ever shows SPACE+BOTH
/// services; an EVENT booking sees everything (Event is the superset workspace — it legitimately
/// needs the venue too).
enum ServiceContext {
  SPACE
  EVENT
  BOTH
}

/// How a service's `defaultPrice` (and a sold line's snapshot `unitPrice`) is meant to be applied.
/// `PER_GUEST`/`PER_UNIT` multipliers are resolved once, at write time, against the booking's real
/// `guestCount`/the line's own `quantity` — never recomputed live at read time.
enum PriceType {
  FIXED
  PER_GUEST
  PER_HOUR
  PER_UNIT
}

/// A named bundle of catalog services. Applying one to a booking explodes it into individual
/// BookingService lines at each service's normal price. When `pricingMode = COMPUTED` (the default),
/// the bundle carries no price of its own — the total is always computed live from its `PackageItem`s,
/// so it can never drift out of sync — and applied lines stay fully editable afterward (spec: "apply
/// packages, edit price/quantity/cost per line"). When `pricingMode = FIXED`, `price` is an explicit
/// negotiated flat rate for the whole bundle instead.
model Package {
  id          String             @id @default(cuid())
  tenantId    String
  name        String
  description String?
  context     PackageContext
  pricingMode PackagePricingMode @default(COMPUTED)
  /// Only meaningful when `pricingMode = FIXED` — ignored (and left null on new rows) otherwise.
  price       Decimal?           @db.Decimal(12, 2)
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items           PackageItem[]
  bookingPackages BookingPackage[]

  @@index([tenantId])
  @@index([context])
  @@index([active])
  @@map("packages")
}

model PackageItem {
  id            String   @id @default(cuid())
  tenantId      String
  packageId     String
  serviceId     String
  /// Display/apply order within the package.
  order         Int      @default(0)
  /// How many units of this service the package bundles by default (e.g. "300 chairs") — editable
  /// per line after the package is applied to a booking, same as everything else about that line.
  quantity      Decimal  @default(1) @db.Decimal(12, 2)
  /// Overrides the service's catalog `defaultPrice` for this package only, when set. Null means
  /// "use whatever the service normally costs" — most package lines leave this unset.
  priceOverride Decimal? @db.Decimal(12, 2)

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([packageId, serviceId])
  @@index([tenantId])
  @@index([packageId])
  @@index([serviceId])
  @@map("package_items")
}

model BookingService {
  id               String          @id @default(cuid())
  /// The commercial owner of this line — always set. A space-only booking's lines have no
  /// `eventId`; that's how a booking can exist with commercial service lines and no Event.
  bookingId        String
  /// Null for a SPACE booking's lines — commercial-only, no operational Event workspace exists
  /// for them. Set for every EVENT booking's lines.
  eventId          String?
  serviceId        String
  /// Which workspace this specific line belongs to — independent of `Booking.context`, since one
  /// EVENT booking can carry both space-package-sourced and event-package-sourced lines at once.
  /// Resolved at creation: from the source Package's context when `source = PACKAGE`, otherwise
  /// from whichever workspace the line was added from.
  context          ServiceContext
  /// Snapshot of `Service.priceType` at the moment this line was sold — protects a historical line
  /// from silently changing meaning if the catalog service's price type is edited afterward.
  priceType        PriceType
  providerType     ExecutionType   @default(INTERNAL)
  /// How many units of the service this line represents (e.g. 10 for "10 Extra Tables") — kept in
  /// sync with `sellingPrice = unitPrice * quantity` at write time. Persisting this (rather than only
  /// the total) is what lets a fixed-price multi-unit line survive an edit-reload with its original
  /// quantity intact, instead of collapsing to a bare total with no way to recover how it was composed.
  quantity         Decimal         @default(1) @db.Decimal(12, 2)
  /// Per-unit price at the time this line was added — `sellingPrice` is the authoritative total,
  /// this is what composed it. Backfilled from `sellingPrice` for every pre-existing row (all of
  /// which were implicitly quantity 1).
  unitPrice        Decimal         @default(0) @db.Decimal(12, 2)
  /// Whether this line was added directly from the catalog or exploded out of an applied Package.
  /// Purely provenance — a `PACKAGE`-sourced line is exactly as editable as a `DIRECT` one afterward.
  source           ServiceSource   @default(DIRECT)
  /// Which package application produced this line, when `source = PACKAGE`. Null for `DIRECT` lines.
  /// Losing this link (e.g. the snapshot row being removed) never deletes the line itself — see
  /// `BookingPackage`'s `onDelete: SetNull` below.
  bookingPackageId String?
  sellingPrice     Decimal         @default(0) @db.Decimal(12, 2)
  cost             Decimal         @default(0) @db.Decimal(12, 2)
  status           WorkOrderStatus @default(PLANNING)
  notes            String?

  /// Snapshot of `Service.name` at the time this work order was created — protects historical
  /// records from showing the wrong name if the catalog service is later renamed or deactivated.
  serviceNameSnapshot String?

  supplierId     String?
  supplierCost   Decimal              @default(0) @db.Decimal(12, 2)
  /// Null for INTERNAL services — the supplier workflow only applies when providerType = EXTERNAL.
  supplierStatus SupplierStatus?
  paymentStatus  ServicePaymentStatus @default(UNPAID)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking        Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  event          Event?          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  service        Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  bookingPackage BookingPackage? @relation(fields: [bookingPackageId], references: [id], onDelete: SetNull)

  serviceTasks          BookingServiceTask[]
  staffAssignments      BookingServiceStaff[]
  resources             BookingServiceResource[]
  inventoryTransactions InventoryTransaction[]
  expenses              Expense[]
  sourcePackageItems    BookingPackageItem[]

  @@index([bookingId])
  @@index([eventId])
  @@index([serviceId])
  @@index([supplierId])
  @@index([bookingPackageId])
  @@index([status])
  @@index([providerType])
  @@map("booking_services")
}

/// A frozen record of one "Add Package" application to a booking — `nameSnapshot` and every
/// `BookingPackageItem`'s price/quantity are locked at the moment this is created, so a later edit
/// to the source `Package`'s catalog definition can never retroactively change what a past booking
/// was actually sold. The `BookingService` lines it exploded into (`source: PACKAGE`,
/// `bookingPackageId` set) stay fully independent afterward — deleting this snapshot (which the app
/// never does) would only lose the "which package" attribution, not the sold lines themselves.
model BookingPackage {
  id           String         @id @default(cuid())
  bookingId    String
  packageId    String
  nameSnapshot String
  /// Snapshot of the source `Package.context` at the moment this was applied — protects this
  /// record from changing meaning if the catalog package's context is edited afterward.
  context      PackageContext
  /// Snapshot of the source `Package.price`, only when its `pricingMode` was `FIXED` at application
  /// time. Null when it was `COMPUTED` — the total is (and was) derived from the exploded lines.
  price        Decimal?       @db.Decimal(12, 2)
  createdAt    DateTime       @default(now())

  booking         Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  package         Package              @relation(fields: [packageId], references: [id], onDelete: Restrict)
  items           BookingPackageItem[]
  bookingServices BookingService[]

  @@index([bookingId])
  @@index([packageId])
  @@map("booking_packages")
}

model BookingPackageItem {
  id               String   @id @default(cuid())
  tenantId         String
  bookingPackageId String
  serviceId        String?
  /// Ties this template line to the exact `BookingService` it exploded into, for full
  /// package-item → sold-line traceability (not just "this booking used this package"). Null only
  /// for rows that predate this back-link.
  bookingServiceId String?
  /// Snapshot of `Service.name` at application time — same protection as
  /// `BookingService.serviceNameSnapshot`, independent of whether the catalog service still exists.
  serviceName      String
  quantity         Decimal  @db.Decimal(12, 2)
  unitPrice        Decimal  @db.Decimal(12, 2)
  totalPrice       Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())

  bookingPackage BookingPackage  @relation(fields: [bookingPackageId], references: [id], onDelete: Cascade)
  service        Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  bookingService BookingService? @relation(fields: [bookingServiceId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([bookingPackageId])
  @@index([bookingServiceId])
  @@map("booking_package_items")
}

model BookingServiceTask {
  id               String     @id @default(cuid())
  bookingServiceId String
  title            String
  status           TaskStatus @default(PENDING)
  assignedTo       String?
  dueDate          DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  bookingService BookingService @relation(fields: [bookingServiceId], references: [id], onDelete: Cascade)

  @@index([bookingServiceId])
  @@map("booking_service_tasks")
}

model BookingServiceStaff {
  id               String   @id @default(cuid())
  bookingServiceId String
  staffId          String
  role             String?
  startAt          DateTime
  endAt            DateTime
  createdAt        DateTime @default(now())

  /// Snapshot of `Staff.name` at assignment time — protects historical records if the staff
  /// member is later renamed or deactivated.
  staffNameSnapshot String

  bookingService BookingService @relation(fields: [bookingServiceId], references: [id], onDelete: Cascade)
  staff          Staff          @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([bookingServiceId])
  @@index([staffId])
  @@index([startAt, endAt])
  @@map("booking_service_staff")
}

model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  phone     String?
  email     String?
  category  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookingServices BookingService[]
  expenses        Expense[]

  @@index([tenantId])
  @@index([active])
  @@map("suppliers")
}

/// Groups InventoryItem variants (e.g. "Chair" groups Gold Chiavari / White Tiffany / Black Folding) —
/// what a category-based ServiceInventoryRequirement matches against, replacing the old free-text
/// `InventoryItem.category` string with a real FK so a rename/typo can't silently break compatibility
/// matching.
model InventoryCategory {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items        InventoryItem[]
  requirements ServiceInventoryRequirement[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("inventory_categories")
}

model InventoryItem {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  /// Renamed from `quantity` — this is the master physical stock count, kept Int since venue
  /// furniture/equipment is whole-unit; every *flow* quantity elsewhere (requirements, reservations,
  /// transactions) is Decimal to allow fractional operational units later.
  totalQuantity Int      @default(0)
  categoryId    String
  sku           String?
  unit          String   @default("unit")
  description   String?
  /// Common variant characteristics as real, queryable/filterable/displayable columns — not buried in
  /// JSON. Each is nullable since not every category uses every field (an AC unit has no color).
  color         String?
  material      String?
  model         String?
  size          String?
  shape         String?
  /// Extension-only overflow for category-specific or future attributes that don't earn their own
  /// column — never the primary home for color/material/model/size/shape above.
  attributes    Json?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant              Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category            InventoryCategory             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  serviceRequirements ServiceInventoryRequirement[]
  bookingResources    BookingServiceResource[]
  transactions        InventoryTransaction[]

  @@index([tenantId])
  @@index([active])
  @@index([categoryId])
  @@map("inventory_items")
}

/// Catalog template — "this Service normally requires X." Never reserves inventory by itself (§16); it
/// only informs what a `BookingServiceResourceRequirement` gets seeded with once a later phase wires up
/// the auto-seed write path. Either hard-links one specific `InventoryItem`, or names a `category` so any
/// item within it qualifies (e.g. "needs 100 Chairs," not "needs 100 Gold Chiavari Chairs specifically") —
/// the concrete variant is chosen per booking, never baked into the catalog.
model ServiceInventoryRequirement {
  id              String       @id @default(cuid())
  tenantId        String
  serviceId       String
  inventoryItemId String?
  categoryId      String?
  quantity        Decimal      @db.Decimal(12, 2)
  quantityType    QuantityType @default(FIXED)
  optional        Boolean      @default(false)
  notes           String?
  sortOrder       Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  service         Service                  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem?           @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  category        InventoryCategory?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Every per-booking resource row seeded from this template across every booking it's been applied to.
  seededResources BookingServiceResource[]

  @@unique([serviceId, inventoryItemId])
  @@index([inventoryItemId])
  @@index([categoryId])
  @@map("service_inventory_requirements")
}

/// The single source of truth for one physical resource attached to one `BookingService` — required,
/// reserved, and used quantities plus lifecycle status all live on the same row, reachable from any
/// booking regardless of whether it has an Event (no `eventId` anywhere on this model — that's the
/// whole point). Created at `PLANNED` when a service with `ServiceInventoryRequirement` templates is
/// added to a booking (§16: never reserves anything by itself); `inventoryItemId` is the
/// resolved/chosen variant, null while a category-based requirement hasn't had a specific item
/// picked yet. `reservedQuantity` is "how much of `requiredQuantity` is actually covered" — whether
/// by a direct reservation or by reusing another row's already-committed stock (see
/// `reusedFromResourceId`) — so `additionalQuantity` (required minus reserved) is always computable
/// on read, never stored.
model BookingServiceResource {
  id               String  @id @default(cuid())
  tenantId         String
  bookingId        String
  bookingServiceId String
  inventoryItemId  String?
  /// Set once inventoryItemId is resolved; null while a category-based requirement is unresolved.
  itemNameSnapshot String?

  requiredQuantity Decimal      @db.Decimal(12, 2)
  reservedQuantity Decimal      @default(0) @db.Decimal(12, 2)
  usedQuantity     Decimal      @default(0) @db.Decimal(12, 2)
  quantityType     QuantityType @default(FIXED)

  /// The window this resource is needed for — defaults to the parent Booking's own span when the row
  /// is seeded (before anything is actually reserved), refined to a narrower window at reserve time
  /// when the resource's real need window differs from the full booking.
  startAt DateTime
  endAt   DateTime
  status  ResourceAllocationStatus @default(PLANNED)

  /// Which ServiceInventoryRequirement this was seeded from; null if added ad hoc directly on the booking.
  sourceRequirementId  String?
  /// Set when this row's `reservedQuantity` is fulfilled by claiming another row's already-reserved
  /// stock instead of committing fresh inventory — e.g. an Event service reusing what a Space service
  /// already reserved on the same booking. The combined reservedQuantity of every row pointing at the
  /// same target can never exceed the target's own reservedQuantity — see `assertReuseQuantityAvailable`.
  reusedFromResourceId String?
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  booking           Booking                      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingService    BookingService               @relation(fields: [bookingServiceId], references: [id], onDelete: Cascade)
  inventoryItem     InventoryItem?               @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  sourceRequirement ServiceInventoryRequirement? @relation(fields: [sourceRequirementId], references: [id], onDelete: SetNull)
  reusedFrom        BookingServiceResource?      @relation("Reuse", fields: [reusedFromResourceId], references: [id], onDelete: SetNull)
  /// Every other row (typically on a different, later-added service) that reuses this row's already-
  /// committed stock instead of creating a duplicate reservation.
  reusedBy          BookingServiceResource[]     @relation("Reuse")
  transactions      InventoryTransaction[]

  @@index([tenantId])
  @@index([bookingId])
  @@index([bookingServiceId])
  @@index([inventoryItemId])
  @@index([sourceRequirementId])
  @@index([reusedFromResourceId])
  @@index([status])
  @@index([inventoryItemId, startAt, endAt])
  @@map("booking_service_resources")
}

/// The inventory movement ledger — "what physically happened," independent of a reservation's commitment
/// status (§32). Never rewritten to hide history; a correction is a new row, not an edit.
model InventoryTransaction {
  id                       String                   @id @default(cuid())
  tenantId                 String
  inventoryItemId          String
  eventId                  String?
  bookingServiceId         String?
  bookingServiceResourceId String?
  type                     InventoryTransactionType
  quantity                 Decimal                  @db.Decimal(12, 2)
  reference                String?
  notes                    String?
  createdBy                String
  createdAt                DateTime                 @default(now())

  inventoryItem  InventoryItem           @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  event          Event?                  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  bookingService BookingService?         @relation(fields: [bookingServiceId], references: [id], onDelete: SetNull)
  resource       BookingServiceResource? @relation(fields: [bookingServiceResourceId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([inventoryItemId])
  @@index([eventId])
  @@index([bookingServiceId])
  @@index([bookingServiceResourceId])
  @@map("inventory_transactions")
}

model Staff {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  role      String
  email     String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments BookingServiceStaff[]

  @@index([tenantId])
  @@index([active])
  @@map("staff")
}

model Guest {
  id             String   @id @default(cuid())
  eventId        String
  name           String
  email          String?
  status         String   @default("PENDING")
  plusOnes       Int      @default(0)
  menuPreference String?  @default("STANDARD")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([status])
  @@map("guests")
}

/// A version of a booking's payment schedule. Only one plan per booking is ever `active` — the
/// one the allocation engine currently applies transactions against. Editing the schedule creates
/// a new version rather than mutating rows in place, so old plans stay as permanent history
/// (never deleted) — "a plan change writes a new version and re-applies history."
model PaymentPlan {
  id        String   @id @default(cuid())
  bookingId String
  version   Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  booking           Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  scheduledPayments ScheduledPayment[]

  @@unique([bookingId, version])
  @@index([bookingId])
  @@index([active])
  @@map("payment_plans")
}

model ScheduledPayment {
  id          String        @id @default(cuid())
  tenantId    String
  bookingId   String
  planId      String
  name        String
  amount      Decimal       @db.Decimal(12, 2)
  /// Cached/derived — recalculated from the payment allocation engine (src/lib/payment-allocation.ts)
  /// on every payment write. Not authoritative; PaymentTransaction rows are the source of truth.
  paidAmount  Decimal       @default(0) @db.Decimal(12, 2)
  /// Cached/derived, same as paidAmount above.
  status      PaymentStatus @default(PENDING)
  dueDate     DateTime
  /// Explicit allocation-order tie-breaker (alongside dueDate, then createdAt) — lets a payment plan
  /// be reordered independently of due dates without changing which milestone is "the deposit."
  orderNumber Int?
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking      Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  plan         PaymentPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]
  allocations  PaymentAllocation[]

  @@index([bookingId])
  @@index([planId])
  @@map("scheduled_payments")
}

model PaymentTransaction {
  id                 String        @id @default(cuid())
  tenantId           String
  bookingId          String
  scheduledPaymentId String?
  amount             Decimal       @db.Decimal(12, 2)
  method             PaymentMethod
  reference          String?
  recordedBy         String
  notes              String?
  date               DateTime      @default(now())
  createdAt          DateTime      @default(now())

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking          Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  scheduledPayment ScheduledPayment?   @relation(fields: [scheduledPaymentId], references: [id], onDelete: SetNull)
  allocations      PaymentAllocation[]

  @@index([bookingId])
  @@map("payment_transactions")
}

/// Persisted breakdown of how much of a `PaymentTransaction` was applied to a given
/// `ScheduledPayment` row. Recomputed (deleted and rewritten) by
/// `syncScheduledPaymentAllocations` every time a payment is recorded/removed or the plan
/// changes — never hand-edited, since `PaymentTransaction` itself stays immutable and the
/// cascade-allocation algorithm is the single source of truth for how money is split.
model PaymentAllocation {
  id                 String   @id @default(cuid())
  transactionId      String
  scheduledPaymentId String
  amount             Decimal  @db.Decimal(12, 2)
  createdAt          DateTime @default(now())

  transaction      PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  scheduledPayment ScheduledPayment   @relation(fields: [scheduledPaymentId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([scheduledPaymentId])
  @@map("payment_allocations")
}

model Expense {
  id               String        @id @default(cuid())
  tenantId         String
  eventId          String?
  supplierId       String?
  /// Links this expense to the specific work order it came from. Set automatically when an
  /// EXTERNAL BookingService's supplierCost is created/updated (see events/[id]/services route) —
  /// null for manually-entered general operational expenses.
  bookingServiceId String?
  description      String
  amount           Decimal       @db.Decimal(12, 2)
  category         String
  status           ExpenseStatus @default(PENDING)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event          Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  bookingService BookingService? @relation(fields: [bookingServiceId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([eventId])
  @@index([supplierId])
  @@index([bookingServiceId])
  @@index([status])
  @@map("expenses")
}
