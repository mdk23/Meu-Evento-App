datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

enum BookingType {
  SPACE_ONLY
  SERVICES_ONLY
  SPACE_AND_SERVICES
}

/// Which workspace a booking belongs to. SPACE = venue-rental only, no Event exists yet.
/// EVENT = the booking runs a full occasion. Distinct from `BookingType`, which is advisory
/// line-composition metadata; `kind` is the structural switch the Space/Event workspace split
/// is built on.
enum BookingKind {
  SPACE
  EVENT
}

enum BookingStatus {
  RESERVED
  CONFIRMED
  COMPLETED
  CANCELLED
  DRAFT
  PENDING_CONFIRMATION
  WAITING_LIST
}

enum EventStatus {
  PLANNING
  READY
  IN_PROGRESS
  COMPLETED
}

enum ExecutionType {
  INTERNAL
  EXTERNAL
}

/// Internal execution ladder for a work order — how far along the venue's own team is.
enum WorkOrderStatus {
  PLANNING
  READY
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// External supplier fulfillment ladder — independent of WorkOrderStatus and of payment.
/// Only meaningful when providerType = EXTERNAL; null for INTERNAL services.
enum SupplierStatus {
  REQUESTED
  CONFIRMED
  DELIVERED
  COMPLETED
  CANCELLED
}

/// Whether the supplier has been paid for this work order — independent of delivery status
/// (a supplier can have delivered and not been paid, or been paid in advance of delivery).
enum ServicePaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  M_PESA
  E_MOLA
  BCI
  BIM
  CONTA_MOVEL
  OTHER
}

enum ExpenseStatus {
  PENDING
  PAID
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  space               Space?
  clients             Client[]
  bookings            Booking[]
  services            Service[]
  servicePackages     ServicePackage[]
  suppliers           Supplier[]
  inventoryItems      InventoryItem[]
  staff               Staff[]
  scheduledPayments   ScheduledPayment[]
  paymentTransactions PaymentTransaction[]
  expenses            Expense[]

  @@map("tenants")
}

model Space {
  id          String   @id @default(cuid())
  tenantId    String   @unique
  name        String
  capacity    Int
  address     String?
  description String?
  photos      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("spaces")
}

model Client {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  phone       String?
  email       String?
  companyName String?
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([tenantId])
  @@index([active])
  @@map("clients")
}

model Booking {
  id                 String        @id @default(cuid())
  tenantId           String
  clientId           String
  spaceId            String
  bookingType        BookingType   @default(SPACE_AND_SERVICES)
  /// Structural workspace switch — see `BookingKind` doc comment. Defaults to EVENT because,
  /// historically, every booking got an Event unconditionally; SPACE bookings are a new concept.
  kind               BookingKind   @default(EVENT)
  eventDate          DateTime
  /// Real reservation window for the space, used for overlap-conflict checking.
  /// `eventDate` stays in sync (same calendar day as `startAt`) for existing day-level UI/queries.
  startAt            DateTime
  endAt              DateTime
  guestCount         Int           @default(0)
  status             BookingStatus @default(RESERVED)
  notes              String?
  depositDueDate     DateTime?
  discount           Decimal?      @default(0) @db.Decimal(12, 2)
  /// Required to confirm a booking whose guestCount exceeds the space's capacity — otherwise
  /// confirmation is blocked. Null when capacity was never exceeded or never overridden.
  capacityOverrideReason String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client              Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  space               Space                @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  event               Event?
  eventServices       EventService[]
  scheduledPayments   ScheduledPayment[]
  paymentTransactions PaymentTransaction[]

  @@index([tenantId])
  @@index([clientId])
  @@index([spaceId])
  @@index([status])
  @@index([kind])
  @@index([eventDate])
  @@index([startAt, endAt])
  @@map("bookings")
}

model Event {
  id         String      @id @default(cuid())
  bookingId  String      @unique
  name       String
  date       DateTime
  guestCount Int         @default(0)
  status     EventStatus @default(PLANNING)
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  booking               Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  eventServices         EventService[]
  guests                Guest[]
  expenses              Expense[]
  inventoryReservations InventoryReservation[]
  statusOverrides       EventStatusOverride[]

  @@index([bookingId])
  @@index([status])
  @@index([date])
  @@map("events")
}

/// Audit trail for manual Event.status overrides (Phase 10). Status is normally derived from
/// EventService progress — every entry here represents a deliberate manual correction, not the
/// default path, and the next automatic recalculation (any service status change) can supersede it.
model EventStatusOverride {
  id             String      @id @default(cuid())
  eventId        String
  previousStatus EventStatus
  newStatus      EventStatus
  reason         String
  overriddenBy   String
  createdAt      DateTime    @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_status_overrides")
}

model Service {
  id             String        @id @default(cuid())
  tenantId       String
  name           String
  category       String
  /// The execution type this service defaults to when added to an event. Purely a suggested
  /// starting point — `EventService.providerType` is the real per-event decision and can differ.
  defaultExecutionType ExecutionType @default(INTERNAL)
  priceType      String        @default("FIXED")
  defaultPrice   Decimal       @default(0) @db.Decimal(12, 2)
  /// Defines the dynamic operational fields this service's work orders should collect —
  /// an array of `{ key, type, label?, options? }`. `EventService.customFields` then stores
  /// only the values, keyed by `key`. Supported `type`s: text, textarea, number, select,
  /// multiselect, date, datetime, boolean.
  fieldSchema    Json?
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventServices   EventService[]
  packageServices PackageService[]

  @@index([tenantId])
  @@index([category])
  @@index([active])
  @@map("services")
}

/// Which workspace a bundle is offered in — Space packages are room-only bundles (e.g. the venue
/// + furniture), Event packages bundle a full occasion's services (catering, decor, etc.).
enum PackageScope {
  SPACE
  EVENT
}

/// A named bundle of catalog services. Applying one to a booking explodes it into individual
/// EventService lines at each service's normal price — the bundle itself carries no price of its
/// own, so applied lines stay fully editable afterward (spec: "apply packages, edit price/
/// quantity/cost per line").
model ServicePackage {
  id          String       @id @default(cuid())
  tenantId    String
  name        String
  description String?
  scope       PackageScope
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services PackageService[]

  @@index([tenantId])
  @@index([scope])
  @@index([active])
  @@map("service_packages")
}

model PackageService {
  id        String @id @default(cuid())
  packageId String
  serviceId String
  /// Display/apply order within the package.
  order     Int    @default(0)

  package ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([packageId, serviceId])
  @@index([packageId])
  @@index([serviceId])
  @@map("package_services")
}

model EventService {
  id           String          @id @default(cuid())
  /// The commercial owner of this line — always set. A space-only booking's lines have no
  /// `eventId`; that's how a booking can exist with commercial service lines and no Event.
  bookingId    String
  /// Null for a SPACE booking's lines — commercial-only, no operational Event workspace exists
  /// for them. Set for every EVENT booking's lines.
  eventId      String?
  serviceId    String
  providerType ExecutionType   @default(INTERNAL)
  sellingPrice Decimal         @default(0) @db.Decimal(12, 2)
  cost         Decimal         @default(0) @db.Decimal(12, 2)
  status       WorkOrderStatus @default(PLANNING)
  notes        String?

  /// Snapshot of `Service.name` at the time this work order was created — protects historical
  /// records from showing the wrong name if the catalog service is later renamed or deactivated.
  serviceNameSnapshot String?

  customFields String?

  supplierId     String?
  supplierCost   Decimal              @default(0) @db.Decimal(12, 2)
  /// Null for INTERNAL services — the supplier workflow only applies when providerType = EXTERNAL.
  supplierStatus SupplierStatus?
  paymentStatus  ServicePaymentStatus @default(UNPAID)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking  Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  event    Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  service  Service   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  serviceTasks          EventServiceTask[]
  staffAssignments      EventServiceStaff[]
  inventoryReservations InventoryReservation[]
  expenses              Expense[]

  @@index([bookingId])
  @@index([eventId])
  @@index([serviceId])
  @@index([supplierId])
  @@index([status])
  @@index([providerType])
  @@map("event_services")
}

model EventServiceTask {
  id             String     @id @default(cuid())
  eventServiceId String
  title          String
  status         TaskStatus @default(PENDING)
  assignedTo     String?
  dueDate        DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  eventService EventService @relation(fields: [eventServiceId], references: [id], onDelete: Cascade)

  @@index([eventServiceId])
  @@map("event_service_tasks")
}

model EventServiceStaff {
  id             String   @id @default(cuid())
  eventServiceId String
  staffId        String
  role           String?
  startAt        DateTime
  endAt          DateTime
  createdAt      DateTime @default(now())

  /// Snapshot of `Staff.name` at assignment time — protects historical records if the staff
  /// member is later renamed or deactivated.
  staffNameSnapshot String

  eventService EventService @relation(fields: [eventServiceId], references: [id], onDelete: Cascade)
  staff        Staff        @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([eventServiceId])
  @@index([staffId])
  @@index([startAt, endAt])
  @@map("event_service_staff")
}

model InventoryReservation {
  id              String   @id @default(cuid())
  eventId         String
  eventServiceId  String
  inventoryItemId String
  quantity        Int
  startAt         DateTime
  endAt           DateTime
  createdAt       DateTime @default(now())

  /// Snapshot of `InventoryItem.name` at reservation time — protects historical records if the
  /// item is later renamed or deactivated.
  itemNameSnapshot String

  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventService  EventService  @relation(fields: [eventServiceId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([eventServiceId])
  @@index([inventoryItemId])
  @@index([startAt, endAt])
  @@map("inventory_reservations")
}

model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  phone     String?
  email     String?
  category  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventServices EventService[]
  expenses      Expense[]

  @@index([tenantId])
  @@index([active])
  @@map("suppliers")
}

model InventoryItem {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  quantity  Int      @default(0)
  category  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservations InventoryReservation[]

  @@index([tenantId])
  @@index([active])
  @@map("inventory_items")
}

model Staff {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  role      String
  email     String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments EventServiceStaff[]

  @@index([tenantId])
  @@index([active])
  @@map("staff")
}

model Guest {
  id             String   @id @default(cuid())
  eventId        String
  name           String
  email          String?
  status         String   @default("PENDING")
  plusOnes       Int      @default(0)
  menuPreference String?  @default("STANDARD")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([status])
  @@map("guests")
}

model ScheduledPayment {
  id          String        @id @default(cuid())
  tenantId    String
  bookingId   String
  name        String
  amount      Decimal       @db.Decimal(12, 2)
  /// Cached/derived — recalculated from the payment allocation engine (src/lib/payment-allocation.ts)
  /// on every payment write. Not authoritative; PaymentTransaction rows are the source of truth.
  paidAmount  Decimal       @default(0) @db.Decimal(12, 2)
  /// Cached/derived, same as paidAmount above.
  status      PaymentStatus @default(PENDING)
  dueDate     DateTime
  /// Explicit allocation-order tie-breaker (alongside dueDate, then createdAt) — lets a payment plan
  /// be reordered independently of due dates without changing which milestone is "the deposit."
  orderNumber Int?
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking      Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]

  @@index([bookingId])
  @@map("scheduled_payments")
}

model PaymentTransaction {
  id                 String        @id @default(cuid())
  tenantId           String
  bookingId          String
  scheduledPaymentId String?
  amount             Decimal       @db.Decimal(12, 2)
  method             PaymentMethod
  reference          String?
  recordedBy         String
  notes              String?
  date               DateTime      @default(now())
  createdAt          DateTime      @default(now())

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking          Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  scheduledPayment ScheduledPayment? @relation(fields: [scheduledPaymentId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@map("payment_transactions")
}

model Expense {
  id             String        @id @default(cuid())
  tenantId       String
  eventId        String?
  supplierId     String?
  /// Links this expense to the specific work order it came from. Set automatically when an
  /// EXTERNAL EventService's supplierCost is created/updated (see events/[id]/services route) —
  /// null for manually-entered general operational expenses.
  eventServiceId String?
  description    String
  amount         Decimal       @db.Decimal(12, 2)
  category       String
  status         ExpenseStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event        Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  supplier     Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  eventService EventService? @relation(fields: [eventServiceId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([eventId])
  @@index([supplierId])
  @@index([eventServiceId])
  @@index([status])
  @@map("expenses")
}
